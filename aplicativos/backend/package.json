{
  "name": "@trak/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "2.55.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.6",
    "@nestjs/testing": "11.0.11",
    "@types/express": "5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "22.14.1",
    "eslint": "9.25.1",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "^29.4.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!testes/**",
      "!main.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}

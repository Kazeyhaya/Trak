{
  "name": "trak",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "aplicativos/*",
    "pacotes/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @trak/web",
    "dev:api": "npm run start:dev --workspace @trak/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
